{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "jsx": "react",
    "jsxFactory": "h",
    "jsxFragmentFactory": "Fragment",
    "typeRoots": ["./node_modules/@types", "./.claude-plugin/types"],
    "types": ["bun", "claude-code"]
  },
  "include": ["core", "content", "sim", "scripts", "hooks", "types"]
}
